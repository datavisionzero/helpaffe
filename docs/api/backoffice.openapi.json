{
  "openapi": "3.1.0",
  "info": {
    "title": "helpaffe Backoffice API",
    "version": "0.1.0",
    "description": "The shared human and named-agent contract for support work. Browser-only access and credential administration operations are documented separately in docs/api.md."
  },
  "servers": [{ "url": "/api/backoffice" }],
  "security": [{ "browserSession": [] }, { "agentToken": [] }],
  "paths": {
    "/assignees": {
      "get": {
        "operationId": "listAssignees",
        "summary": "List active support users eligible in the caller's visible project scope",
        "parameters": [
          { "name": "project_id", "in": "query", "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Eligible assignees", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Assignee" } } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/tickets": {
      "get": {
        "operationId": "listTickets",
        "summary": "List tickets in the caller's current project scope",
        "parameters": [
          { "name": "status", "in": "query", "schema": { "$ref": "#/components/schemas/TicketStatus" } },
          { "name": "priority", "in": "query", "schema": { "$ref": "#/components/schemas/TicketPriority" } },
          { "name": "project_id", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "assignee_id", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "mine", "in": "query", "schema": { "type": "boolean", "default": false } },
          { "name": "search", "in": "query", "description": "PostgreSQL web-style full-text query across ticket metadata and conversation text", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Visible tickets", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TicketPage" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/tickets/next": {
      "post": {
        "operationId": "acquireNextTicket",
        "summary": "Atomically acquire the highest-priority longest-waiting eligible ticket",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object",
          "properties": { "project_id": { "type": ["string", "null"], "format": "uuid" } },
          "additionalProperties": false
        } } } },
        "responses": {
          "200": { "description": "Acquired ticket, assigned to the responsible user and In Progress", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TicketDetail" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/tickets/{number}": {
      "parameters": [{ "$ref": "#/components/parameters/TicketNumber" }],
      "get": {
        "operationId": "getTicket",
        "summary": "Read one ticket with its complete support context",
        "responses": {
          "200": { "description": "Ticket, requester, instructions, and conversation", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TicketDetail" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "operationId": "updateTicket",
        "summary": "Change ticket status, priority, or assignee",
        "parameters": [{ "$ref": "#/components/parameters/IfMatch" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateTicket" } } } },
        "responses": {
          "200": { "description": "Updated ticket context", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TicketDetail" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "412": { "$ref": "#/components/responses/Stale" },
          "428": { "$ref": "#/components/responses/VersionRequired" }
        }
      }
    },
    "/tickets/{number}/requester-tickets": {
      "parameters": [{ "$ref": "#/components/parameters/TicketNumber" }],
      "get": {
        "operationId": "listRequesterTickets",
        "summary": "List other visible tickets for the same stable requester id in the same project",
        "parameters": [
          { "name": "status", "in": "query", "schema": { "$ref": "#/components/schemas/TicketStatus" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Other tickets for this requester and project", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TicketPage" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/tickets/{number}/replies": {
      "parameters": [{ "$ref": "#/components/parameters/TicketNumber" }],
      "post": {
        "operationId": "replyToTicket",
        "summary": "Atomically add a public reply and set its resulting status",
        "parameters": [{ "$ref": "#/components/parameters/IfMatch" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AddReply" } } } },
        "responses": {
          "200": { "description": "Updated or replayed ticket context", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TicketDetail" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "412": { "$ref": "#/components/responses/Stale" },
          "428": { "$ref": "#/components/responses/VersionRequired" }
        }
      }
    },
    "/tickets/{number}/notes": {
      "parameters": [{ "$ref": "#/components/parameters/TicketNumber" }],
      "post": {
        "operationId": "addTicketNote",
        "summary": "Add a support-only internal note",
        "parameters": [{ "$ref": "#/components/parameters/IfMatch" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AddNote" } } } },
        "responses": {
          "200": { "description": "Updated or replayed ticket context", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TicketDetail" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "412": { "$ref": "#/components/responses/Stale" },
          "428": { "$ref": "#/components/responses/VersionRequired" }
        }
      }
    },
    "/tickets/{number}/notifications/{notificationId}/retry": {
      "parameters": [
        { "$ref": "#/components/parameters/TicketNumber" },
        { "name": "notificationId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "post": {
        "operationId": "retryTicketNotification",
        "summary": "Queue a failed ticket email delivery for another immediate attempt",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": {
          "200": { "description": "Notification reset to pending, or an idempotent replay", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationDelivery" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/projects/{projectId}": {
      "parameters": [{ "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "patch": {
        "operationId": "updateProject",
        "summary": "Change a visible project's key or name as an administrator or administrator agent",
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object",
          "properties": { "key": { "type": "string", "minLength": 1, "maxLength": 32 }, "name": { "type": "string", "minLength": 1, "maxLength": 200 } },
          "additionalProperties": false
        } } } },
        "responses": {
          "200": { "description": "Updated project", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectSummary" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/projects/{projectId}/support-instructions": {
      "parameters": [{ "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "get": {
        "operationId": "getSupportInstructions",
        "summary": "Read the visible project's Markdown support instructions",
        "responses": {
          "200": { "description": "Support instructions", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SupportInstructions" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "operationId": "updateSupportInstructions",
        "summary": "Replace support instructions as an administrator or administrator agent",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["markdown"], "properties": { "markdown": { "type": "string" } }, "additionalProperties": false } } } },
        "responses": {
          "200": { "description": "Updated support instructions", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SupportInstructions" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/projects/{projectId}/email-settings": {
      "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
      "get": {
        "operationId": "getProjectEmailSettings",
        "summary": "Read project email settings without returning the SMTP password",
        "responses": {
          "200": { "description": "Effective email settings", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmailSettings" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "operationId": "putProjectEmailSettings",
        "summary": "Create or replace SMTP, sender, recipient, branding, and ticket-link settings",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PutEmailSettings" } } } },
        "responses": {
          "200": { "description": "Stored email settings with only password_configured exposed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmailSettings" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthenticated" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/projects/{projectId}/email-templates": {
      "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
      "get": {
        "operationId": "listProjectEmailTemplates",
        "summary": "List all five effective English notification templates",
        "responses": {
          "200": { "description": "Default and customized templates", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/EmailTemplate" } } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/projects/{projectId}/email-templates/{type}": {
      "parameters": [{ "$ref": "#/components/parameters/ProjectId" }, { "$ref": "#/components/parameters/EmailTemplateType" }],
      "get": {
        "operationId": "getProjectEmailTemplate",
        "summary": "Read one effective English notification template",
        "responses": {
          "200": { "description": "Effective template", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmailTemplate" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "operationId": "putProjectEmailTemplate",
        "summary": "Create or replace a project template, rejecting unknown variables",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PutEmailTemplate" } } } },
        "responses": {
          "200": { "description": "Customized template", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmailTemplate" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthenticated" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/projects/{projectId}/email-templates/{type}/preview": {
      "parameters": [{ "$ref": "#/components/parameters/ProjectId" }, { "$ref": "#/components/parameters/EmailTemplateType" }],
      "post": {
        "operationId": "previewProjectEmailTemplate",
        "summary": "Render a template with safe sample values",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TemplateSample" } } } },
        "responses": {
          "200": { "description": "Rendered subject, text, and HTML", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RenderedEmail" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/projects/{projectId}/email/test": {
      "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
      "post": {
        "operationId": "sendProjectTestEmail",
        "summary": "Render and submit one test email through the project's SMTP server",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TestEmail" } } } },
        "responses": {
          "200": { "description": "The test message was submitted to SMTP" },
          "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthenticated" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "502": { "description": "SMTP refused the test message", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "browserSession": { "type": "apiKey", "in": "cookie", "name": "helpaffe_session" },
      "agentToken": { "type": "http", "scheme": "bearer", "bearerFormat": "hfa_ token" }
    },
    "parameters": {
      "TicketNumber": { "name": "number", "in": "path", "required": true, "schema": { "type": "string", "maxLength": 32 }, "example": "HLP-42" },
      "IfMatch": { "name": "If-Match", "in": "header", "required": true, "schema": { "type": "string", "pattern": "^\\\"[1-9][0-9]*\\\"$" }, "example": "\"8\"" },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 200 } },
      "ProjectId": { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "EmailTemplateType": { "name": "type", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/EmailTemplateType" } }
    },
    "headers": {
      "ETag": { "description": "Quoted positive ticket version", "schema": { "type": "string" }, "example": "\"8\"" }
    },
    "responses": {
      "BadRequest": { "description": "Validation or cursor error", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Unauthenticated": { "description": "Credential missing, unknown, or revoked", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Forbidden": { "description": "The actor cannot perform this operation", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "NotFound": { "description": "Resource absent, outside project scope, or no eligible next ticket", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Conflict": { "description": "An idempotency key was reused for a different request", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Stale": { "description": "The ticket version changed", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/StaleProblem" } } } },
      "VersionRequired": { "description": "If-Match was omitted", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
    },
    "schemas": {
      "TicketStatus": { "type": "string", "enum": ["open", "in_progress", "waiting_for_customer", "resolved"] },
      "TicketPriority": { "type": "string", "enum": ["normal", "urgent"] },
      "ProjectSummary": {
        "type": "object",
        "required": ["id", "key", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "key": { "type": "string" },
          "name": { "type": "string" }
        },
        "additionalProperties": false
      },
      "UserSummary": {
        "type": ["object", "null"],
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" }
        },
        "additionalProperties": false
      },
      "Assignee": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" }
        },
        "additionalProperties": false
      },
      "TicketSummary": {
        "type": "object",
        "required": ["id", "number", "project", "subject", "status", "priority", "version", "assignee", "created_at", "updated_at", "last_customer_reply_at", "waiting_since"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "number": { "type": "string" },
          "project": { "$ref": "#/components/schemas/ProjectSummary" },
          "subject": { "type": "string" },
          "status": { "$ref": "#/components/schemas/TicketStatus" },
          "priority": { "$ref": "#/components/schemas/TicketPriority" },
          "version": { "type": "integer", "minimum": 1 },
          "assignee": { "$ref": "#/components/schemas/UserSummary" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "last_customer_reply_at": { "type": "string", "format": "date-time" },
          "waiting_since": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "TicketPage": {
        "type": "object",
        "required": ["items", "next_cursor"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/TicketSummary" } },
          "next_cursor": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      },
      "Requester": {
        "type": "object",
        "required": ["external_user_id", "name", "email"],
        "properties": {
          "external_user_id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" }
        },
        "additionalProperties": false
      },
      "Actor": {
        "type": ["object", "null"],
        "required": ["user_id", "user_name", "agent_id", "agent_name"],
        "properties": {
          "user_id": { "type": "string", "format": "uuid" },
          "user_name": { "type": ["string", "null"] },
          "agent_id": { "type": ["string", "null"], "format": "uuid" },
          "agent_name": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      },
      "ConversationEntry": {
        "type": "object",
        "required": ["id", "sequence", "kind", "body", "is_public", "created_at", "actor"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "sequence": { "type": "integer", "minimum": 1 },
          "kind": { "type": "string", "enum": ["customer_message", "public_reply", "internal_note", "system_event"] },
          "body": { "type": "string" },
          "is_public": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" },
          "actor": { "$ref": "#/components/schemas/Actor" }
        },
        "additionalProperties": false
      },
      "NotificationDelivery": {
        "type": "object",
        "required": ["id", "type", "target_kind", "recipient_email", "status", "attempt_count", "next_attempt_at", "submitted_at", "last_error", "created_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "type": { "$ref": "#/components/schemas/EmailTemplateType" },
          "target_kind": { "type": "string", "enum": ["customer", "assignee", "support_recipients"] },
          "recipient_email": { "type": ["string", "null"], "format": "email", "description": "Null until a support-recipient job is expanded" },
          "status": { "type": "string", "enum": ["pending", "submitted_to_smtp", "failed"] },
          "attempt_count": { "type": "integer", "minimum": 0 },
          "next_attempt_at": { "type": ["string", "null"], "format": "date-time" },
          "submitted_at": { "type": ["string", "null"], "format": "date-time" },
          "last_error": { "type": ["string", "null"] },
          "created_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "TicketDetail": {
        "type": "object",
        "required": ["summary", "requester", "context", "support_instructions", "notifications", "conversation"],
        "properties": {
          "summary": { "$ref": "#/components/schemas/TicketSummary" },
          "requester": { "$ref": "#/components/schemas/Requester" },
          "context": { "type": ["object", "null"], "description": "Immutable JSON snapshot supplied when the product created the ticket", "additionalProperties": true },
          "support_instructions": { "type": "string" },
          "notifications": { "type": "array", "items": { "$ref": "#/components/schemas/NotificationDelivery" } },
          "conversation": { "type": "array", "items": { "$ref": "#/components/schemas/ConversationEntry" } }
        },
        "additionalProperties": false
      },
      "UpdateTicket": {
        "type": "object",
        "properties": {
          "status": { "$ref": "#/components/schemas/TicketStatus" },
          "priority": { "$ref": "#/components/schemas/TicketPriority" },
          "assignee_id": { "type": ["string", "null"], "format": "uuid" },
          "clear_assignee": { "type": "boolean", "default": false }
        },
        "additionalProperties": false
      },
      "AddReply": {
        "type": "object",
        "required": ["message", "status"],
        "properties": {
          "message": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["in_progress", "waiting_for_customer", "resolved"] }
        },
        "additionalProperties": false
      },
      "AddNote": {
        "type": "object",
        "required": ["message"],
        "properties": { "message": { "type": "string", "minLength": 1 } },
        "additionalProperties": false
      },
      "EmailTemplateType": {
        "type": "string",
        "enum": ["new_ticket_customer", "new_ticket_support", "customer_reply_support", "public_reply_customer", "assignment_support"]
      },
      "EmailSettings": {
        "type": "object",
        "required": ["project_id", "project_name", "language", "smtp", "sender", "support_recipients", "branding", "ticket_links"],
        "properties": {
          "project_id": { "type": "string", "format": "uuid" },
          "project_name": { "type": "string" },
          "language": { "type": "string", "const": "en" },
          "smtp": {
            "type": "object", "required": ["host", "port", "use_tls", "username", "password_configured"],
            "properties": {
              "host": { "type": "string", "maxLength": 255 }, "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "use_tls": { "type": "boolean" }, "username": { "type": ["string", "null"], "maxLength": 320 },
              "password_configured": { "type": "boolean", "description": "Indicates whether an encrypted password exists; the password and ciphertext are never returned" }
            }, "additionalProperties": false
          },
          "sender": { "$ref": "#/components/schemas/EmailSender" },
          "support_recipients": { "type": "array", "items": { "type": "string", "format": "email" } },
          "branding": { "$ref": "#/components/schemas/EmailBranding" },
          "ticket_links": { "$ref": "#/components/schemas/TicketLinks" }
        },
        "additionalProperties": false
      },
      "PutEmailSettings": {
        "type": "object",
        "required": ["language", "smtp", "sender", "support_recipients", "branding", "ticket_links"],
        "properties": {
          "language": { "type": "string", "const": "en" },
          "smtp": {
            "type": "object", "required": ["host", "port", "use_tls"],
            "properties": {
              "host": { "type": "string", "minLength": 1, "maxLength": 255 }, "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "use_tls": { "type": "boolean" }, "username": { "type": ["string", "null"], "maxLength": 320 },
              "password": { "type": ["string", "null"], "maxLength": 4096, "description": "Omit or null to preserve the existing encrypted password" }
            }, "additionalProperties": false
          },
          "sender": { "$ref": "#/components/schemas/EmailSenderInput" },
          "support_recipients": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "email" } },
          "branding": { "$ref": "#/components/schemas/EmailBranding" },
          "ticket_links": { "$ref": "#/components/schemas/TicketLinksInput" }
        },
        "additionalProperties": false
      },
      "EmailSender": {
        "type": "object", "required": ["name", "email"],
        "properties": { "name": { "type": "string", "maxLength": 200 }, "email": { "type": "string", "maxLength": 320 } },
        "additionalProperties": false
      },
      "EmailSenderInput": {
        "type": "object", "required": ["name", "email"],
        "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 200 }, "email": { "type": "string", "format": "email", "maxLength": 320 } },
        "additionalProperties": false
      },
      "EmailBranding": {
        "type": "object", "required": ["name", "logo_url", "color"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "logo_url": { "type": ["string", "null"], "format": "uri", "maxLength": 2048 },
          "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        }, "additionalProperties": false
      },
      "TicketLinks": {
        "type": "object", "required": ["customer", "backoffice"],
        "properties": {
          "customer": { "type": "string", "maxLength": 2048 },
          "backoffice": { "type": "string", "maxLength": 2048 }
        }, "additionalProperties": false
      },
      "TicketLinksInput": {
        "type": "object", "required": ["customer", "backoffice"],
        "properties": {
          "customer": { "type": "string", "format": "uri-template", "maxLength": 2048, "description": "Absolute HTTP(S) URL containing {{ticket_number}}" },
          "backoffice": { "type": "string", "format": "uri-template", "maxLength": 2048, "description": "Absolute HTTP(S) URL containing {{ticket_number}}" }
        }, "additionalProperties": false
      },
      "EmailTemplate": {
        "type": "object",
        "required": ["type", "description", "subject", "text_body", "html_body", "variables", "is_customized"],
        "properties": {
          "type": { "$ref": "#/components/schemas/EmailTemplateType" }, "description": { "type": "string" },
          "subject": { "type": "string", "maxLength": 300 }, "text_body": { "type": "string", "maxLength": 65536 }, "html_body": { "type": "string", "maxLength": 65536 },
          "variables": { "type": "array", "items": { "type": "string" } }, "is_customized": { "type": "boolean" }
        }, "additionalProperties": false
      },
      "PutEmailTemplate": {
        "type": "object", "required": ["subject", "text_body", "html_body"],
        "properties": {
          "subject": { "type": "string", "minLength": 1, "maxLength": 300 },
          "text_body": { "type": "string", "minLength": 1, "maxLength": 65536 },
          "html_body": { "type": "string", "minLength": 1, "maxLength": 65536 }
        }, "additionalProperties": false
      },
      "TemplateSample": {
        "type": "object",
        "properties": {
          "customer_name": { "type": ["string", "null"] }, "customer_email": { "type": ["string", "null"] },
          "ticket_number": { "type": ["string", "null"] }, "ticket_subject": { "type": ["string", "null"] },
          "message": { "type": ["string", "null"] }, "assignee_name": { "type": ["string", "null"] }
        }, "additionalProperties": false
      },
      "RenderedEmail": {
        "type": "object", "required": ["subject", "text_body", "html_body"],
        "properties": { "subject": { "type": "string" }, "text_body": { "type": "string" }, "html_body": { "type": "string" } },
        "additionalProperties": false
      },
      "TestEmail": {
        "type": "object", "required": ["recipient", "template_type"],
        "properties": {
          "recipient": { "type": "string", "format": "email" }, "template_type": { "$ref": "#/components/schemas/EmailTemplateType" },
          "sample": { "oneOf": [{ "$ref": "#/components/schemas/TemplateSample" }, { "type": "null" }] }
        }, "additionalProperties": false
      },
      "SupportInstructions": {
        "type": "object",
        "required": ["project_id", "project_key", "markdown"],
        "properties": {
          "project_id": { "type": "string", "format": "uuid" },
          "project_key": { "type": "string" },
          "markdown": { "type": "string" }
        },
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status", "detail"],
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string" }
        }
      },
      "StaleProblem": {
        "allOf": [
          { "$ref": "#/components/schemas/Problem" },
          { "type": "object", "required": ["current_version"], "properties": { "current_version": { "type": "integer", "minimum": 1 } } }
        ]
      }
    }
  }
}
