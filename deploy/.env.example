# Copy to .env beside compose.yaml (or deploy/.env for a source build), fill in
# the required values, and restrict access with chmod 600 .env.
# Pin the released application image. Change only after reading release notes.
HELPAFFE_VERSION=0.1.0

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Bind to loopback; put a TLS reverse proxy in front for remote access.
HELPAFFE_BIND_ADDRESS=127.0.0.1
HELPAFFE_HTTP_PORT=5066

# These create the first administrator only when the database has no users.
HELPAFFE_BOOTSTRAP_NAME=Administrator
HELPAFFE_BOOTSTRAP_EMAIL=
# Generate with: openssl rand -base64 24
HELPAFFE_BOOTSTRAP_PASSWORD=
# Generate once with: openssl rand -base64 32
HELPAFFE_SECRETS_ENCRYPTION_KEY=
