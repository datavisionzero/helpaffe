# Copy to deploy/.env and replace this value before starting the full stack.
POSTGRES_PASSWORD=replace-with-a-long-random-value
HELPAFFE_HTTP_PORT=5066
HELPAFFE_BOOTSTRAP_NAME=Administrator
HELPAFFE_BOOTSTRAP_EMAIL=admin@example.com
HELPAFFE_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
# Generate once with: openssl rand -base64 32
HELPAFFE_SECRETS_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
